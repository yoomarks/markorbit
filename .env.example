NODE_ENV=development

POSTGRES_USER=markorbit
POSTGRES_PASSWORD=markorbit-local-only
POSTGRES_DB=markorbit
POSTGRES_PORT=5432
# Local-only example values. Production must inject its own secret configuration.
DATABASE_URL=postgresql://markorbit:markorbit-local-only@localhost:5432/markorbit
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
DB_APPLICATION_NAME=markorbit-local
DB_SSL_MODE=disable
DB_MIGRATION_NAMESPACE=persistence_foundation
DB_TEST_DATABASE=markorbit_test
PERSISTENCE_TEST_DATABASE_URL=postgresql://markorbit_test:markorbit-test-only@localhost:5433/markorbit_test

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

MINIO_ROOT_USER=markorbit
MINIO_ROOT_PASSWORD=markorbit-local-only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=markorbit
S3_SECRET_KEY=markorbit-local-only
S3_BUCKET=markorbit-local
MO_SESSION_TTL_SECONDS=43200
# Required outside explicit local/test fixtures; use a secret of at least 32 random bytes.
MO_INTERNAL_SERVICE_SECRET=
MO_CSRF_SECRET=
CORE_URL=http://127.0.0.1:4101
# Explicit comma-separated browser origins; wildcard credentialed CORS is unsupported.
WEB_ORIGINS=http://127.0.0.1:3000
MO_MILESTONE_TEST_RUNTIME=0
MARKREG_TEST_DATABASE_URL=postgresql://markorbit:markorbit@127.0.0.1:5432/markorbit_markreg_test
MARKREG_POSTGRES_TEST_REQUIRED=0
MARKREG_DATABASE_URL=postgresql://markorbit:markorbit@127.0.0.1:5432/markorbit_markreg
MARKREG_MIGRATION_NAMESPACE=markreg
# Required by the production MarkReg process; Matter Drafts and Customer Confirmations share this MarkReg-owned database.
