{
  "name": "@markorbit/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated routing and product-specific API aggregation boundary.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/index.ts src/main.ts src/data-engine-http.ts src/data-engine-discovery-http.ts --format esm --dts --clean",
    "pretest": "pnpm --filter @markorbit/events build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@markorbit/contracts": "workspace:*",
    "@markorbit/service-kit": "workspace:*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data-engine": {
      "types": "./dist/data-engine-http.d.ts",
      "import": "./dist/data-engine-http.js"
    },
    "./data-engine-discovery": {
      "types": "./dist/data-engine-discovery-http.d.ts",
      "import": "./dist/data-engine-discovery-http.js"
    }
  }
}
