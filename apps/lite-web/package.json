{
  "name": "@markorbit/lite-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:opportunity-candidates:browser": "playwright test --config playwright.opportunity-candidates.config.ts",
    "test:governed-provider:browser": "playwright test --config playwright.governed-provider.config.ts",
    "test:trademark-commerce:browser": "playwright test --config playwright.trademark-commerce.config.ts",
    "test:trading-creative-preview:browser": "playwright test --config playwright.trading-creative-preview.config.ts",
    "test:agency-ia-prototype:browser": "playwright test --config playwright.agency-ia-prototype.config.ts",
    "test:agency-workspace-preview:browser": "playwright test --config playwright.agency-workspace-preview.config.ts",
    "test:contextual-workbench-preview:browser": "playwright test --config playwright.contextual-workbench-preview.config.ts",
    "test:customers-preview:browser": "playwright test --config playwright.customers-preview.config.ts",
    "test:content-studio-preview:browser": "playwright test --config playwright.content-studio-preview.config.ts",
    "test:today-workspace-preview:browser": "playwright test --config playwright.today-workspace-preview.config.ts",
    "test:opportunity-center-preview:browser": "playwright test --config playwright.opportunity-center-preview.config.ts",
    "test:ux-trust-visual:browser": "playwright test --config playwright.ux-trust-visual.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts playwright.navigation.config.ts playwright.opportunity-candidates.config.ts playwright.governed-provider.config.ts playwright.trademark-commerce.config.ts playwright.agency-ia-prototype.config.ts playwright.customers-preview.config.ts playwright.content-studio-preview.config.ts playwright.today-workspace-preview.config.ts playwright.opportunity-center-preview.config.ts playwright.ux-trust-visual.config.ts",
    "build-storybook": "storybook build -c ../../packages/ui/.storybook"
  },
  "dependencies": {
    "@markorbit/ui": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@markorbit/contracts": "workspace:*",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@storybook/react": "8.6.18",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "3.5.9",
    "jsdom": "26.1.0",
    "jest-axe": "10.0.0",
    "storybook": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-a11y": "8.6.18"
  }
