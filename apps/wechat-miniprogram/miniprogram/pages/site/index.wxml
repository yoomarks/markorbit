<view class="status" wx:if="{{viewState === 'loading'}}" aria-role="status" aria-label="Opening service Site">
  <view class="spinner"></view>
  <text>Opening service Site…</text>
</view>

<view class="status" wx:elif="{{viewState === 'error'}}" aria-role="alert">
  <text class="status__title">Service unavailable</text>
  <text class="status__copy">{{errorMessage}}</text>
  <button bindtap="retry" aria-label="Try loading the service Site again">Try again</button>
</view>

<view class="page" wx:else style="--brand-color: {{site.primaryColor}}">
  <view class="header" aria-role="banner">
    <text class="brand">{{site.brandName}}</text>
    <text class="eyebrow">Trademark services · {{site.market}}</text>
  </view>

  <view class="notice" wx:if="{{viewState === 'partial'}}" aria-role="status">
    Service content is still being prepared. Current services remain owner-backed below.
  </view>

  <view class="hero" aria-role="main">
    <text class="hero__title">{{site.hero.title || 'Plan your trademark filing with clarity.'}}</text>
    <text class="hero__copy">{{site.hero.description || 'Review the current service and continue to the governed intake.'}}</text>
  </view>

  <view class="section">
    <text class="section__title">Available services</text>
    <view class="notice" wx:if="{{viewState === 'empty'}}" aria-role="status">
      This Site is active, but no public service is currently available.
    </view>
    <view class="service" wx:for="{{site.services}}" wx:key="key">
      <text class="service__title">{{item.title}}</text>
      <text>{{item.detail}}</text>
      <text class="meta">{{item.meta}}</text>
      <button
        class="primary"
        data-url="{{item.handoffUrl}}"
        bindtap="startService"
        aria-label="Continue to governed intake for {{item.title}}"
      >Start consultation</button>
    </view>
  </view>

  <view class="section" wx:for="{{site.details}}" wx:key="slot">
    <text class="section__title">{{item.title}}</text>
    <text wx:if="{{item.description}}">{{item.description}}</text>
  </view>

  <view class="footer" aria-role="contentinfo">
    <text>{{site.brandName}}</text>
    <text>Site {{site.siteId}} · configuration {{site.configurationVersion}}</text>
  </view>
</view>
