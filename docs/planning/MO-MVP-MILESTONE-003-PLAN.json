    "id": "DURABLE_COMMERCIAL_ORDER_AND_MATTER_LINKAGE",
    "selected": true,
    "summary": "Introduce a durable governed trademark-service Order and explicit Order-to-Formal-Matter relationship without Payment, Invoice, provider appointment or external filing authority."
  },
  "decisionAlternatives": [
    {
      "id": "DURABLE_COMMERCIAL_ORDER_AND_MATTER_LINKAGE",
      "decision": "SELECT",
      "risk": "MEDIUM",
      "reason": "Closes the canonical commercial-request gap on top of Milestone 2 durable authenticated Matter operations."
    },
    {
      "id": "PAYMENT_AND_INVOICE_TRANSACTION_LAYER",
      "decision": "DEFER",
      "risk": "HIGH",
      "reason": "Canonical Order MVP defers payment processing and invoice lifecycle; finance requires stable Order and party ownership first."
    },
    {
      "id": "EXTERNAL_FILING_EXECUTION",
      "decision": "DEFER",
      "risk": "VERY_HIGH",
      "reason": "Requires protected external authority, provider/office integration and Official Truth semantics not established by Milestone 3."
    }
  ],
