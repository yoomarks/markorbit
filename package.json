{
  "name": "@markorbit/workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:real-runtime": "playwright test --config playwright.real-runtime.config.ts",
    "test:runtime": "node --test scripts/milestone-runtime.test.mjs scripts/playwright-suite-boundary.test.mjs scripts/validate-persistence-boundaries.test.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:visual": "playwright test --config playwright.config.ts --grep @visual",
    "validate:workspace": "node scripts/validate-workspace.mjs",
    "validate:persistence-boundaries": "node scripts/validate-persistence-boundaries.mjs",
    "check": "pnpm validate:workspace && pnpm validate:persistence-boundaries && pnpm test:story-matrix && pnpm test:gateway-inventory && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "tsx packages/persistence/src/cli.ts migrate infrastructure/persistence/migrations",
    "db:migrate:status": "tsx packages/persistence/src/cli.ts status infrastructure/persistence/migrations",
    "db:migrate:verify": "tsx packages/persistence/src/cli.ts verify infrastructure/persistence/migrations",
    "db:test:bootstrap": "tsx packages/persistence/src/cli.ts bootstrap-test infrastructure/persistence/migrations",
    "test:persistence": "pnpm --filter @markorbit/persistence test:persistence",
    "build:identity-postgres-deps": "turbo run build --filter=@markorbit/core-service...",
    "test:identity:postgres": "pnpm build:identity-postgres-deps && pnpm --filter @markorbit/core-service test:postgres",
    "build:auth-deps": "turbo run build --filter=@markorbit/core-service... --filter=@markorbit/gateway...",
    "test:auth": "pnpm build:auth-deps && pnpm --filter @markorbit/core-service exec vitest run tests/auth.test.ts tests/session-memory-contract.test.ts && pnpm --filter @markorbit/gateway exec vitest run tests/auth-boundary.test.ts",
    "test:auth:postgres": "pnpm build:auth-deps && pnpm --filter @markorbit/core-service test:auth:postgres",
    "test:auth:http": "pnpm build:auth-deps && pnpm exec vitest run scripts/auth-http.integration.test.ts",
    "infra:config": "docker compose -f infrastructure/docker-compose.yml config",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "infra:reset": "docker compose -f infrastructure/docker-compose.yml down -v",
    "test:story-matrix": "node scripts/validate-story-matrix.mjs",
    "build:storybook-matrix": "pnpm --filter @markorbit/ui build && rm -rf .artifacts/storybook && pnpm --filter @markorbit/markreg-web exec storybook build -c ../../packages/ui/.storybook -o ../../.artifacts/storybook/markreg && pnpm --filter @markorbit/lite-web exec storybook build -c ../../packages/ui/.storybook -o ../../.artifacts/storybook/lite",
    "test:storybook-index": "node scripts/validate-storybook-index.mjs .artifacts/storybook/markreg/index.json .artifacts/storybook/lite/index.json",
    "test:gateway-inventory": "node scripts/validate-gateway-inventory.mjs",
    "build:negative-path-deps": "turbo run build --filter=@markorbit/markreg-service... --filter=@markorbit/execution-service... --filter=@markorbit/gateway...",
    "test:negative-path-matrix:prepare": "pnpm build:negative-path-deps",
    "test:negative-path-matrix:coverage": "node scripts/validate-negative-path-matrix.mjs",
    "test:negative-path-matrix": "pnpm test:negative-path-matrix:prepare && node scripts/run-negative-path-matrix.mjs",
    "test:negative-path-matrix:markreg": "pnpm test:negative-path-matrix:prepare && node scripts/run-negative-path-matrix.mjs --markreg",
    "test:negative-path-matrix:execution": "pnpm test:negative-path-matrix:prepare && node scripts/run-negative-path-matrix.mjs --execution"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "1.54.2",
    "@types/node": "^22.15.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
