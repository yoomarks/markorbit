{
  "name": "@markorbit/workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:real-runtime": "playwright test --config playwright.real-runtime.config.ts",
    "test:runtime": "node --test scripts/milestone-runtime.test.mjs scripts/playwright-suite-boundary.test.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:visual": "playwright test --config playwright.config.ts --grep @visual",
    "validate:workspace": "node scripts/validate-workspace.mjs",
    "check": "pnpm validate:workspace && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:config": "docker compose -f infrastructure/docker-compose.yml config",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "infra:reset": "docker compose -f infrastructure/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "1.54.2",
    "@types/node": "^22.15.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
