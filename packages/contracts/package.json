{
  "name": "@markorbit/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-service transport contracts and governed references.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./order": {
      "types": "./dist/order.d.ts",
      "import": "./dist/order.js"
    },
    "./commercial": {
      "types": "./dist/commercial.d.ts",
      "import": "./dist/commercial.js"
    },
    "./payment": {
      "types": "./dist/payment.d.ts",
      "import": "./dist/payment.js"
    },
    "./provider-execution": {
      "types": "./dist/provider-execution.d.ts",
      "import": "./dist/provider-execution.js"
    },
    "./evidence-lifecycle": {
      "types": "./dist/evidence-lifecycle.d.ts",
      "import": "./dist/evidence-lifecycle.js"
    },
    "./knowledge-content-export": {
      "types": "./dist/knowledge-content-export.d.ts",
      "import": "./dist/knowledge-content-export.js"
    },
    "./knowledge-ready-package-v2": {
      "types": "./dist/knowledge-ready-package-v2.d.ts",
      "import": "./dist/knowledge-ready-package-v2.js"
    },
    "./product-loop": {
      "types": "./dist/product-loop.d.ts",
      "import": "./dist/product-loop.js"
    },
    "./daily-workspace": {
      "types": "./dist/daily-workspace.d.ts",
      "import": "./dist/daily-workspace.js"
    },
    "./daily-source": {
      "types": "./dist/daily-source.d.ts",
      "import": "./dist/daily-source.js"
    },
    "./data-engine": {
      "types": "./dist/data-engine.d.ts",
      "import": "./dist/data-engine.js"
    },
    "./capability-learning": {
      "types": "./dist/capability-learning.d.ts",
      "import": "./dist/capability-learning.js"
    },
    "./beta-readiness": {
      "types": "./dist/beta-readiness.d.ts",
      "import": "./dist/beta-readiness.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/order.ts src/commercial.ts src/payment.ts src/provider-execution.ts src/evidence-lifecycle.ts src/knowledge-content-export.ts src/knowledge-ready-package-v2.ts src/product-loop.ts src/daily-workspace.ts src/daily-source.ts src/data-engine.ts src/capability-learning.ts src/beta-readiness.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
