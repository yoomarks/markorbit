{
  "name": "@markorbit/core-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared semantic, identity-reference and permission boundary.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/index.ts src/main.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:postgres": "vitest run tests/identity-postgres.test.ts",
    "test:auth:postgres": "vitest run tests/session-postgres.test.ts",
    "test:knowledge-intake:postgres": "vitest run tests/knowledge-intake-postgres.test.ts",
    "test:knowledge-v2-delivery:postgres": "vitest run tests/knowledge-v2-delivery-postgres.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@markorbit/contracts": "workspace:*",
    "@markorbit/persistence": "workspace:*",
    "@markorbit/service-kit": "workspace:*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
