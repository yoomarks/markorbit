{
  "name": "@markorbit/core-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared semantic, identity-reference and permission boundary.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/index.ts src/main.ts src/brain-asset-registry.ts src/brain-asset-registry-postgres.ts src/brain-evidence-resolver.ts src/brain-confidence-engine.ts src/brain-build-runtime.ts src/brain-self-audit.ts src/brain-build-self-audit-observation.ts src/brain-gap-registry.ts src/official-fee-reference-store.ts src/official-fee-reference-store-postgres.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:postgres": "vitest run tests/identity-postgres.test.ts && vitest run tests/method-outcome-evidence-postgres.test.ts && vitest run tests/method-outcome-report-postgres.test.ts && vitest run tests/method-improvement-postgres.test.ts",
    "test:auth:postgres": "vitest run tests/session-postgres.test.ts && vitest run tests/account-access-postgres.test.ts && vitest run tests/account-onboarding-postgres.test.ts",
    "test:knowledge-intake:postgres": "vitest run tests/knowledge-intake-postgres.test.ts",
    "test:knowledge-v2-delivery:postgres": "vitest run tests/knowledge-v2-delivery-postgres.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "start": "node dist/main.js",
    "test:brain-registry:postgres": "vitest run tests/brain-asset-registry-postgres.test.ts && vitest run tests/official-fee-reference-store-postgres.test.ts",
    "test:official-fee-reference:postgres": "vitest run tests/official-fee-reference-store-postgres.test.ts"
  },
  "dependencies": {
    "@markorbit/contracts": "workspace:*",
    "@markorbit/persistence": "workspace:*",
    "@markorbit/service-kit": "workspace:*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brain-asset-registry": {
      "types": "./dist/brain-asset-registry.d.ts",
      "import": "./dist/brain-asset-registry.js"
    },
    "./brain-evidence-resolver": {
      "types": "./dist/brain-evidence-resolver.d.ts",
      "import": "./dist/brain-evidence-resolver.js"
    },
    "./brain-confidence-engine": {
      "types": "./dist/brain-confidence-engine.d.ts",
      "import": "./dist/brain-confidence-engine.js"
    },
    "./brain-build-runtime": {
      "types": "./dist/brain-build-runtime.d.ts",
      "import": "./dist/brain-build-runtime.js"
    },
    "./brain-self-audit": {
      "types": "./dist/brain-self-audit.d.ts",
      "import": "./dist/brain-self-audit.js"
    },
    "./brain-build-self-audit-observation": {
      "types": "./dist/brain-build-self-audit-observation.d.ts",
      "import": "./dist/brain-build-self-audit-observation.js"
    },
    "./brain-gap-registry": {
      "types": "./dist/brain-gap-registry.d.ts",
      "import": "./dist/brain-gap-registry.js"
    },
    "./brain-asset-registry-postgres": {
      "types": "./dist/brain-asset-registry-postgres.d.ts",
      "import": "./dist/brain-asset-registry-postgres.js"
    },
    "./official-fee-reference-store": {
      "types": "./dist/official-fee-reference-store.d.ts",
      "import": "./dist/official-fee-reference-store.js"
    },
    "./official-fee-reference-store-postgres": {
      "types": "./dist/official-fee-reference-store-postgres.d.ts",
      "import": "./dist/official-fee-reference-store-postgres.js"
    }
  }
}
