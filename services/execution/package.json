{
  "name": "@markorbit/execution-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Execution plans, work, review, approval, evidence and receipt boundary.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/index.ts src/main.ts src/reviewed-source-handoff.ts src/reviewed-source-handoff-http.ts src/evidence-provenance-http.ts src/trademark-service-execution.ts src/trademark-service-execution-postgres.ts src/trademark-service-execution-sandbox.ts src/trademark-service-execution-sandbox-postgres.ts src/trademark-service-execution-connectors.ts src/trademark-service-execution-isolation.ts src/trademark-service-execution-simulation.ts src/trademark-service-execution-readiness-bundle.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@markorbit/contracts": "workspace:*",
    "@markorbit/events": "workspace:*",
    "@markorbit/persistence": "workspace:*",
    "@markorbit/service-kit": "workspace:*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reviewed-source-handoff": {
      "types": "./dist/reviewed-source-handoff.d.ts",
      "import": "./dist/reviewed-source-handoff.js"
    },
    "./reviewed-source-handoff-http": {
      "types": "./dist/reviewed-source-handoff-http.d.ts",
      "import": "./dist/reviewed-source-handoff-http.js"
    },
    "./evidence-provenance-http": {
      "types": "./dist/evidence-provenance-http.d.ts",
      "import": "./dist/evidence-provenance-http.js"
    },
    "./trademark-service-execution": {
      "types": "./dist/trademark-service-execution.d.ts",
      "import": "./dist/trademark-service-execution.js"
    },
    "./trademark-service-execution-postgres": {
      "types": "./dist/trademark-service-execution-postgres.d.ts",
      "import": "./dist/trademark-service-execution-postgres.js"
    },
    "./trademark-service-execution-sandbox": {
      "types": "./dist/trademark-service-execution-sandbox.d.ts",
      "import": "./dist/trademark-service-execution-sandbox.js"
    },
    "./trademark-service-execution-sandbox-postgres": {
      "types": "./dist/trademark-service-execution-sandbox-postgres.d.ts",
      "import": "./dist/trademark-service-execution-sandbox-postgres.js"
    },
    "./trademark-service-execution-connectors": {
      "types": "./dist/trademark-service-execution-connectors.d.ts",
      "import": "./dist/trademark-service-execution-connectors.js"
    },
    "./trademark-service-execution-isolation": {
      "types": "./dist/trademark-service-execution-isolation.d.ts",
      "import": "./dist/trademark-service-execution-isolation.js"
    },
    "./trademark-service-execution-simulation": {
      "types": "./dist/trademark-service-execution-simulation.d.ts",
      "import": "./dist/trademark-service-execution-simulation.js"
    },
    "./trademark-service-execution-readiness-bundle": {
      "types": "./dist/trademark-service-execution-readiness-bundle.d.ts",
      "import": "./dist/trademark-service-execution-readiness-bundle.js"
    }
  }
}
