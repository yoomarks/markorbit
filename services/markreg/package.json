{
  "name": "@markorbit/markreg-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dual-channel international trademark recommendation, order and Matter service.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/index.ts src/main.ts src/lifecycle-projection.ts src/lifecycle-handoff-http.ts src/lifecycle-surface-http.ts src/recommended-action.ts src/formal-opportunity.ts src/formal-opportunity-http.ts src/knowledge-case-promotion.ts src/knowledge-case-promotion-postgres.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@markorbit/contracts": "workspace:*",
    "@markorbit/events": "workspace:*",
    "@markorbit/persistence": "workspace:*",
    "@markorbit/service-kit": "workspace:*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lifecycle-projection": {
      "types": "./dist/lifecycle-projection.d.ts",
      "import": "./dist/lifecycle-projection.js"
    },
    "./lifecycle-handoff-http": {
      "types": "./dist/lifecycle-handoff-http.d.ts",
      "import": "./dist/lifecycle-handoff-http.js"
    },
    "./lifecycle-surface-http": {
      "types": "./dist/lifecycle-surface-http.d.ts",
      "import": "./dist/lifecycle-surface-http.js"
    },
    "./recommended-action": {
      "types": "./dist/recommended-action.d.ts",
      "import": "./dist/recommended-action.js"
    },
    "./formal-opportunity": {
      "types": "./dist/formal-opportunity.d.ts",
      "import": "./dist/formal-opportunity.js"
    },
    "./formal-opportunity-http": {
      "types": "./dist/formal-opportunity-http.d.ts",
      "import": "./dist/formal-opportunity-http.js"
    },
    "./knowledge-case-promotion": {
      "types": "./dist/knowledge-case-promotion.d.ts",
      "import": "./dist/knowledge-case-promotion.js"
    },
    "./knowledge-case-promotion-postgres": {
      "types": "./dist/knowledge-case-promotion-postgres.d.ts",
      "import": "./dist/knowledge-case-promotion-postgres.js"
    }
  }
}
