{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@markorbit/contracts/order": ["packages/contracts/src/order.ts"],
      "@markorbit/contracts/commercial": ["packages/contracts/src/commercial.ts"],
      "@markorbit/contracts/payment": ["packages/contracts/src/payment.ts"],
      "@markorbit/contracts/provider-execution": ["packages/contracts/src/provider-execution.ts"],
      "@markorbit/contracts/evidence-lifecycle": ["packages/contracts/src/evidence-lifecycle.ts"],
      "@markorbit/contracts/knowledge-content-export": [
        "packages/contracts/src/knowledge-content-export.ts"
      ],
      "@markorbit/contracts/product-loop": ["packages/contracts/src/product-loop.ts"],
      "@markorbit/contracts/data-engine": ["packages/contracts/src/data-engine.ts"],
      "@markorbit/contracts/beta-readiness": ["packages/contracts/src/beta-readiness.ts"],
      "@markorbit/contracts/brain": ["packages/contracts/src/brain.ts"],
      "@markorbit/contracts/brain-evidence": ["packages/contracts/src/brain-evidence.ts"],
      "@markorbit/contracts/*": ["packages/contracts/src/*.ts"],
      "@markorbit/*": ["packages/*/src", "services/*/src", "apps/*/src"],
      "@markorbit/contracts/brain-confidence": ["packages/contracts/src/brain-confidence.ts"],
      "@markorbit/contracts/brain-build": ["packages/contracts/src/brain-build.ts"],
      "@markorbit/contracts/brain-gap": ["packages/contracts/src/brain-gap.ts"]
    }
  }
}
